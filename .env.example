# ── Required ──────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/tickline
# Random 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app (must match the browser origin)
BETTER_AUTH_URL=http://localhost:3000

# ── Market data ───────────────────────────────────────────────────────
# Free key at https://finnhub.io — quotes, profiles, fundamentals, news.
FINNHUB_API_KEY=

# ── Social sign-in (optional; each provider appears once both values are set) ──
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
#   Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: developer.apple.com → Identifiers → Services ID (CLIENT_ID); CLIENT_SECRET is a JWT signed with your .p8 key
#   Return URL: <BETTER_AUTH_URL>/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
# Microsoft: entra.microsoft.com → App registrations (accounts in any org + personal)
#   Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Live stream (optional) ──
# Standalone relay (relay/, docs/streaming.md). When both are set the browser streams from the relay.
STREAM_RELAY_URL=
STREAM_TOKEN_SECRET=
# Batching window for SSE writes (ms) and per-user connect limit for /api/stream
STREAM_FLUSH_MS=250
STREAM_CONNECTS_PER_MINUTE=30
# Enables GET /api/metrics with "Authorization: Bearer <token>" (404 when unset)
METRICS_TOKEN=
# Benchmarks only — never in production: STREAM_SOURCE=synthetic, SYNTHETIC_TPS=20

# ── Tracing (optional) ──
# OpenTelemetry over OTLP, e.g. Grafana Cloud: Connections → OpenTelemetry → copy endpoint + headers
OTEL_SERVICE_NAME=tickline
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Public contact shown in the Privacy Policy and Terms
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Optional ──────────────────────────────────────────────────────────
# Gemini key for personalised welcome emails and daily news digests
GEMINI_API_KEY=
# Gmail address + app password used to send alert / digest emails
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
EMAIL_FROM_NAME=Tickline
# Inngest Cloud keys (production). Local dev uses the Inngest dev server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# debug | info | warn | error
LOG_LEVEL=info
